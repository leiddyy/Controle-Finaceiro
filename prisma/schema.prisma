// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  name              String
  email             String             @unique
  password          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  accounts          Account[]
  categories        Category[]
  incomes           Income[]
  expenses          Expense[]
  creditCards       CreditCard[]
  recurringExpenses RecurringExpense[]
  goals             Goal[]
  budgets           Budget[]
}

model Account {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String    // ex: Nubank, Itaú, Carteira
  type      String    @default("CHECKING") // CHECKING, SAVINGS, CASH, INVESTMENT
  balance   Float     @default(0.0)
  color     String    @default("#3b82f6")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  incomes   Income[]
  expenses  Expense[]
}

model Category {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String    @default("tag")
  color     String    @default("#6b7280")
  type      String    @default("EXPENSE") // EXPENSE, INCOME
  createdAt DateTime  @default(now())

  incomes   Income[]
  expenses  Expense[]
  budgets   Budget[]
}

model Income {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Expense {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String
  amount        Float
  date          DateTime
  paymentMethod String      @default("MONEY") // MONEY, DEBIT, CREDIT, PIX
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCardId  String?
  creditCard    CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
}

model CreditCard {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String         // ex: Nubank, Inter
  limit       Float
  closingDay  Int            // Dia do fechamento
  dueDay      Int            // Dia do vencimento
  color       String         @default("#8b5cf6")
  createdAt   DateTime       @default(now())

  purchases   CardPurchase[]
  expenses    Expense[]
}

model CardPurchase {
  id           String        @id @default(uuid())
  creditCardId String
  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  description  String
  totalAmount  Float
  installments Int           @default(1)
  purchaseDate DateTime
  categoryName String        @default("Outros")
  createdAt    DateTime      @default(now())

  installmentItems Installment[]
}

model Installment {
  id             String       @id @default(uuid())
  cardPurchaseId String
  cardPurchase   CardPurchase @relation(fields: [cardPurchaseId], references: [id], onDelete: Cascade)
  number         Int          // Número da parcela (ex: 1, 2, 3)
  amount         Float
  dueDate        DateTime     // Data do mês de cobrança
  paid           Boolean      @default(false)
}

model RecurringExpense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  dueDay      Int      // Dia fixo do mês
  categoryName String  @default("Contas")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Goal {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   // ex: Comprar computador
  targetAmount  Float
  currentAmount Float    @default(0.0)
  targetDate    DateTime?
  icon          String   @default("target")
  color         String   @default("#10b981")
  createdAt     DateTime @default(now())
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  limit      Float
  month      Int      // 1 a 12
  year       Int      // ex: 2026
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId, month, year])
}
